# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Base HTTPS URL (без /webhook — путь /webhook добавляется автоматически)
WEBHOOK_URL=https://thebestweddingbot.thelodka.com

# Обязательный секрет webhook (сгенерировать: openssl rand -hex 32)
WEBHOOK_SECRET=generate_with_openssl_rand_hex_32

# PostgreSQL на сервере Hetzner
DATABASE_URL=postgresql://thebestweddinguser:thelodka_database@localhost:5432/thebestwedding_bot

# Порт webhook-бота (8000/8001 заняты соседними проектами)
PORT=8002

# Порт админ-панели (проксируется Nginx на том же поддомене)
ADMIN_PORT=8003

# Слушать только localhost — снаружи доступ через Nginx
HOST=127.0.0.1
ADMIN_HOST=127.0.0.1

# IP сервера (справка; для деплоя — GitHub Secret SERVER_HOST)
SERVER_HOST=204.168.196.245

# Админ-панель
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SECRET_KEY=generate_random_secret_key

# Опционально
ADMIN_USER_IDS=123456789
LOGS_GROUP_ID=-1001234567890
VIDEO_FILE_ID=
DEBUG=False
